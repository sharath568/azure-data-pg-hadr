# Copy to .env and fill in, or let scripts/up.sh write .env.azure for you.
# Load with:  set -a; . ./.env; set +a

# libpq reads the password from here; keep it out of the DSN.
PGPASSWORD=

# Primary (the server name follows the HA primary after a failover).
PGHADR_DSN="host=<server>.postgres.database.azure.com port=5432 dbname=pghadr user=pghadradmin sslmode=require"
PGHADR_SERVER=<server>
PGHADR_RG=rg-mvp-pghadr

# Cross-region read replica, for pghadr dr-drill.
PGHADR_REPLICA=<server>-dr
PGHADR_REPLICA_DSN="host=<server>-dr.postgres.database.azure.com port=5432 dbname=pghadr user=pghadradmin sslmode=require"
